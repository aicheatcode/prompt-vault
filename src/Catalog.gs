/** Public read-only catalogue. All helper methods are private RPCs. */
const PUBLIC_CATALOG_PARTS={"AI & Prompt":"","Education":"","Marketing":"","Design":"","AI Image & Video":"","Technology":"","Business":"","Finance":"","Careers":"","Writing":"","Everyday Life":""};
function apiPublicCatalog(){
  const changes=apiPublicChanges(),hidden=new Set(changes.hidden||[]),records=new Map();
  for(const encoded of Object.values(PUBLIC_CATALOG_PARTS)){
    const data=Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(encoded))).getDataAsString('UTF-8');
    for(const item of JSON.parse(data))if(!hidden.has(item.id))records.set(item.id,item);
  }
  for(const item of [...changes.overrides,...changes.newPrompts]){
    if(item.status!=='published'||hidden.has(item.id))continue;
    records.set(item.id,Object.assign({},records.get(item.id)||{},item,{source:'owner'}));
  }
  const items=[...records.values()];
  return Object.assign({},changes,{
    catalogCount:items.length,
    catalogData:Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(JSON.stringify(items),'application/json')).getBytes())
  });
}
